{
  "schema": 1,
  "files": [
    "scripts/native_release.py",
    "scripts/test_native_release.py"
  ],
  "timeout": 30,
  "cases": [
    {
      "id": "attempt_race",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "meta.get(\"id\") == run_id and meta.get(\"run_attempt\") == attempt",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_attempt_race"
      ]
    },
    {
      "id": "fork_producer",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "meta.get(\"repository\", {}).get(\"full_name\") == REPO and\n            meta.get(\"head_repository\", {}).get(\"full_name\") == REPO",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_fork_producer"
      ]
    },
    {
      "id": "workflow_identity",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "meta.get(\"path\") == WORKFLOW",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_workflow_identity"
      ]
    },
    {
      "id": "incomplete_producer",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "meta.get(\"status\") == \"completed\" and meta.get(\"conclusion\") == \"success\"",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_incomplete_producer"
      ]
    },
    {
      "id": "duplicate_artifact",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "len(artifacts) == len(ARTIFACTS) and {a.get(\"name\") for a in artifacts} == set(ARTIFACTS)",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_duplicate_artifact"
      ]
    },
    {
      "id": "artifact_source",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "artifact.get(\"workflow_run\", {}).get(\"id\") == run_id and\n                artifact.get(\"workflow_run\", {}).get(\"head_sha\") == meta[\"head_sha\"]",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_artifact_source"
      ]
    },
    {
      "id": "expired_artifact",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "type(artifact.get(\"id\")) is int and artifact[\"id\"] > 0 and not artifact.get(\"expired\", True)",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_expired_artifact"
      ]
    },
    {
      "id": "missing_artifact_digest",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "isinstance(artifact.get(\"digest\"), str) and re.fullmatch(r\"sha256:[0-9a-f]{64}\", artifact[\"digest\"])",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_missing_artifact_digest"
      ]
    },
    {
      "id": "default_source_move",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "current == result[\"source_sha\"]",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_default_source_move"
      ]
    },
    {
      "id": "published_draft",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "draft.get(\"draft\") is True and draft.get(\"target_commitish\") == binding[\"source_sha\"]",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_published_draft"
      ]
    },
    {
      "id": "draft_binding",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "record.get(\"schema_version\") == 1 and record.get(\"binding\") == binding and\n            record.get(\"version\") == version and record.get(\"is_release\") is is_release and\n            type(record.get(\"sign\")) is bool",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_draft_binding"
      ]
    },
    {
      "id": "receipt_author",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "asset.get(\"uploader\", {}).get(\"id\") == OPERATOR",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_receipt_author"
      ]
    },
    {
      "id": "duplicate_evidence",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "len(matches) == 1",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_duplicate_evidence"
      ]
    },
    {
      "id": "receipt_binding",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "receipt.get(\"binding\") == binding and receipt.get(\"draft_id\") == draft_id",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_receipt_binding"
      ]
    },
    {
      "id": "incomplete_workload",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "receipt.get(\"status\") == \"success\" and receipt.get(\"commands\") == [\"go build -p 1 ./...\", \"go vet -p 1 ./...\", \"go test -p 1 ./...\", \"bash scripts/smoke-artifact.sh <packaged-darwin-arm64>\"]",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_incomplete_workload"
      ]
    },
    {
      "id": "runtime_changed",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "set(runtime) == {\"system\", \"machine\", \"python\", \"python_path\", \"python_sha256\", \"go\", \"go_path\", \"go_sha256\"} and\n            all(isinstance(value, str) and value for value in runtime.values()) and\n            runtime.get(\"system\") == \"Darwin\" and runtime.get(\"machine\") == \"arm64\" and\n            runtime == receipt.get(\"runtime_after\")",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_runtime_changed"
      ]
    },
    {
      "id": "log_binding",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "receipt.get(\"log\") == {\"id\": log_asset[\"id\"], \"sha256\": log_hash}",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_log_binding"
      ]
    },
    {
      "id": "native_artifact_binding",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "receipt.get(\"artifact\") == artifact",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_native_artifact_binding"
      ]
    },
    {
      "id": "actual_platform_required",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "platform.system() == \"Darwin\"",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_actual_platform_required"
      ]
    },
    {
      "id": "download_asset_digest",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "server_digest == \"sha256:\" + digest(destination)",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_download_asset_digest"
      ]
    },
    {
      "id": "native_digest_gates_assembly",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "digest(archive) == receipt[\"archive_sha256\"]",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_native_digest_gates_assembly"
      ]
    },
    {
      "id": "final_custody_race",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "validate_draft(final_draft, binding) == record and\n            one_asset(final_draft, RECEIPT, True) == receipt_asset and one_asset(final_draft, LOG, True) == log_asset and\n            producer(args.run, args.attempt) == binding",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_final_custody_race"
      ]
    },
    {
      "id": "packaged_architecture",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "stream.read(8) == b\"\\xcf\\xfa\\xed\\xfe\\x0c\\x00\\x00\\x01\"",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_packaged_architecture"
      ]
    },
    {
      "id": "packaged_link_refusal",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "member.isdir() or member.isfile()",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_packaged_link_refusal"
      ]
    },
    {
      "id": "failed_required_job",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "len(matching) == 1 and matching[0].get(\"status\") == \"completed\" and\n                matching[0].get(\"conclusion\") == \"success\"",
          "after": "True"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_failed_required_job"
      ]
    },
    {
      "id": "valid_controls",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "\"source_sha\": meta[\"head_sha\"],",
          "after": "\"source_sha\": \"f\" * 40,"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_valid_controls"
      ]
    },
    {
      "id": "verified_archive_controls",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "github_outputs({\"version\": record[\"version\"],",
          "after": "github_outputs({\"version\": \"wrong\","
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_verified_archive_controls"
      ]
    },
    {
      "id": "ci_failure_stops_workload",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "[\"go\", \"vet\", \"-p\", \"1\", \"./...\"]",
          "after": "[\"go\", \"list\", \"-p\", \"1\", \"./...\"]"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_ci_failure_stops_workload"
      ]
    },
    {
      "id": "ci_complete_workload",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "[\"go\", \"test\", \"-p\", \"1\", \"./...\"]",
          "after": "[\"go\", \"list\", \"-p\", \"1\", \"./...\"]"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_ci_complete_workload"
      ]
    },
    {
      "id": "packaged_smoke_controls",
      "edits": [
        {
          "path": "scripts/native_release.py",
          "before": "str(Path(top) / \"cct\")], cwd=directory, log=log)",
          "after": "str(binary_path)], cwd=directory, log=log)"
        }
      ],
      "tests": [
        "scripts.test_native_release.NativeReleaseTest.test_packaged_smoke_controls"
      ]
    }
  ]
}
